{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Conversation",
  "version": "2.0.0",
  "identifier": "com.aiconversation.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Conversation",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "focus": true,
        "backgroundColor": "#191919",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Let 2–3 voices take turns on one thread",
    "longDescription": "Desktop multi-agent conversation app. OpenCode Go, Muse Spark 1.3 contributor, streaming, step/auto modes, and saved chats.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
